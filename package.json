{
  "name": "dsh-matt-preset",
  "version": "0.2.1-rc.2-r1",
  "private": true,
  "description": "Matt 工作流 agent preset (ask-matt): persona + workflow-enforcer + tool roster, installed by bin/install.mjs into $DSH_HOME/.agent-presets/matt and mounted as a bundle patch via dsh plugin add (rc.2 preset registry does no directory scanning, #28). agent.cordis.yml is the source of truth; cordis.patch.yml is its generated bundle carrier.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-preset-install": "bin/install.mjs"
  },
  "scripts": {
    "test": "node scripts/verify-all.mjs",
    "link-deps": "node scripts/link-runtime-deps.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "files": [
    "package.json",
    "preset.yml",
    "agent.cordis.yml",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "workflow-gates.yml.example",
    "workflow-core.mjs",
    "workflow-body.txt",
    "workflow-profile-cordis.txt",
    "workflow-profile-ptc.txt",
    "workflow-profile-minimal.txt",
    "*.mjs",
    "lib",
    "skills",
    "lang-packs",
    "sandcastle",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/matt-ptc.patch.yml",
        "./presets/matt-minimal.patch.yml",
        "./presets/matt-cordis.patch.yml"
      ]
    }
  },
  "exports": {
    "./*": "./*",
    "./package.json": "./package.json"
  }
}
