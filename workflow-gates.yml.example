# workflow-gates.yml — per-project gate list for dsh-workflow-enforcer.
#
# Copy to your project root (next to CONTEXT.md) and adjust. When this file
# exists it REPLACES the plugin's default list; set includeDefault: true in
# the plugin config to merge with the defaults instead.
#
# Match rule: every word of an item must appear (case-insensitive) in the
# serialized tool call — so "git push" also matches "git push --force origin".

external:
  - "git push"
  - "gh pr create"
  - "gh issue create"
  - "npm publish"
  - "sandcastle"     # AFK 沙箱批跑（.sandcastle/run-ticket.mts 等任何 sandcastle 调用）
  - "run-ticket"

destructive:
  - "rm -rf"
  - "git reset --hard"
  - "docker compose down -v"
  - "docker-dev.sh reset"   # project-specific cold-start/reset (IRIS 教训)
