#!/bin/sh
# .githooks/pre-commit —— 本仓无 CI（ADR-0004 的边界见 ADR-0013），本地套件即唯一验收通道；
# 提交前跑它。四项：① 分支形态（detached HEAD 拒绝）② index/工作树不脱节
# ③ staged 的 tests/* 新增行里不留实验标记 ④ verify-all 的**默认层（快集）**（#129 分层：
#    @slow 长跑用例不在这一层 —— 全量 `--all` 留到批末 / 推送前 / 交付前；privacy 验收仍在本层，
#    它被显式留在快集，理由见 docs/dev-environment.md §0.2「分层：快集 / --all 全量」）。
# 启用（每个 clone 一次）：git config core.hooksPath .githooks
# 绕过（明确知道自己在跳什么时）：SKIP_HOOKS=1 git commit …
[ -n "$SKIP_HOOKS" ] && { echo "pre-commit: SKIP_HOOKS set — 跳过 verify-all"; exit 0; }

# ① 分支形态：`merge --ff-only` 的副本同步与"提交只在权威树"都依赖分支（邻仓 ADR-0014 的第一项，
# 他们记过同类事故）。判据由 tests/verify-precommit-hook.mjs H4 钉住。
if ! git symbolic-ref -q HEAD >/dev/null; then
  echo "pre-commit: HEAD 处于 detached 状态 —— 先 git switch <branch> 再提交，或用 SKIP_HOOKS=1 明确跳过"
  exit 1
fi

# 提交记录的是 INDEX，而 verify-all 跑的是工作树：两者脱节时门禁为"将要提交的内容"背书，
# 而提交里根本没有它（#82 会话实测：复核后又改了 3 个文件，commit 记下复核前的快照，
# 283/30 vs 347/32，只有事后 git status 才发现，靠两次 amend 补救）。在最便宜的一层先拦：
# 便宜、确定性、且不必先烧一遍套件。判据与逃生口由 tests/verify-precommit-hook.mjs H1–H3 钉住。
UNSTAGED=$(git diff --name-only)
if [ -n "$UNSTAGED" ]; then
  echo "pre-commit: 工作树有未 staged 的改动 —— 本次提交不会包含它们："
  echo "$UNSTAGED" | sed 's/^/  /'
  echo "  复核后请重新 git add -A；确要有意部分暂存则 SKIP_HOOKS=1 git commit …"
  exit 1
fi

# ② 实验标记（[DEBUG-… / [MUTATION-…）不许留在提交里：**标记死了才叫实验**——留下的标记意味着
# "被跑过的那棵树"与提交物不是同一份，而 verify-all 照样会绿（扰动是本仓修复类票的标准取证手段）。
# 只看 staged 的 tests/* **新增行**：文档里叙述这套做法不该被自己拦下（H6）。判据由 H5/H6 钉住。
MARKERS=$(git diff --cached -U0 -- 'tests/*' | grep -E '^\+.*\[(DEBUG|MUTATION)-' || true)
if [ -n "$MARKERS" ]; then
  echo "$MARKERS" | head -5
  echo "pre-commit: staged diff 里还有实验标记（[DEBUG-… / [MUTATION-…）—— 清掉再提交，或用 SKIP_HOOKS=1 明确跳过"
  exit 1
fi

# 找 node：PATH → 常见安装位（msys 的 bash 与 Windows 侧 node 各自 PATH 不同，
# 缺工具链时**响亮跳过**而不是阻断提交 —— 与套件的 loud-skip 惯例一致）。
NODE=$(command -v node 2>/dev/null)
for c in "/c/Program Files/nodejs/node.exe" "/ucrt64/bin/node.exe" "/usr/bin/node"; do
  [ -n "$NODE" ] && break
  [ -x "$c" ] && NODE="$c"
done
if [ -z "$NODE" ]; then
  echo "pre-commit: 找不到 node —— 跳过 verify-all（本次提交未经验证）"
  exit 0
fi

# pathspec 提交（`git commit -- <paths>`，#103/#158 的共享树纪律形态）会给钩子挂
# **绝对路径的临时 index**（GIT_INDEX_FILE 指向它）。上面的 index/工作树检查与实验标记
# 检查需要它（它们判的就是"本次提交的面"）；但 verify-all 及其套件会 spawn git，
# 继承的临时 index 让夹具 git 操作读到父仓对象——实测三测试全红（46/50 → 43/50：
# H3 "invalid object ... Error building trees" / F16 install-root 探针空 / F3 脏树拦截失效，
# #158）。到这里临时 index 已完成使命，unset 掉，让子进程看到每仓自己的常规 index。
unset GIT_INDEX_FILE

echo "pre-commit: $NODE scripts/verify-all.mjs"

echo "pre-commit: $NODE scripts/verify-all.mjs"
"$NODE" scripts/verify-all.mjs || {
  echo "pre-commit: 检查未通过 —— 修掉再提交，或用 SKIP_HOOKS=1 明确跳过"
  exit 1
}