  "reasons": {
    "matt-workflow-core": "matt 特征面：ask-matt 工作流正文（骨架+七门）经 system-prompt/assemble 注入（#54/#99，ADR-0015）；官方 preset 无此形态",
    "matt-workflow-enforcer": "matt 特征面：每 turn WORKFLOW GATES 提醒 + 高危 tool/call 即时追加（D21，docs/workflow-enforcer.md）",
    "matt-lang-enforcer": "matt 特征面：语言知识包层——知识指针与流程门职责隔离（D31，docs/lang-enforcer.md）",
    "matt-handoff-tool": "matt 特征面：/handoff 阶段边界执行器（初始 matt preset fc0c07e 起；会话级边界动作 agent 自身做不了）",
    "matt-str-replace-editor": "matt 特征面：内建文件编辑器行（fc0c07e 起）；官方 preset 未挂、本仓工作流采用（拍板 b 保留增量）",
    "matt-subagent-optional": "matt 特征面：可选 subagent provider 声明（常驻 disabled: true，opt-in 才激活；#92 常驻口径）",
    "matt-tool-ralph": "matt 特征面：ralph 循环执行器（#92 常驻口径，ADR-0015 §4 明示不移出常驻）",
    "minimal-full-roster": "拍板 b：matt-minimal =「正文更短」非「能力更少」——roster 与标准档同一基线（ADR-0015 §4），官方 minimal 裁掉的这些能力面本仓保留；描述已明示「能力面与标准档完全一致」",
    "official-time-context": "不回补（#117 拍板 2026-10-24）：随 schedule-bundle 有意退役（ADR-0001），官方虽独立挂行，本仓维持退役口径",
    "official-tool-schedule": "不追平（方向 b）：ADR-0001 退役同族；schedule_* 工具经 tool-schedule 行声明后才可用（服务层内建，ADR-0001 Considered Options 0.2.1 注）——本仓未声明 ⇒ matt 会话拿不到 schedule_*，拍板 b 有意接受该缺口",
    "ptc-tool-presentation": "归 #116（方向 A 已拍：挂行；定序 #116 先交付，本票不重复实现）——SG10 已登记该承诺↔roster 缺口",
    "minimal-terminal-family": "不追平（方向 b）：官方 minimal 以 terminal/persistent-shell 族替代 tool-bash/tool-pwsh 的极简 shell 形态；matt-minimal 保留全量能力面（tool-bash/tool-pwsh 走宿主沙箱路径），不引入第二套 shell 面"
  },
